# --- База данных SQLite ---
# БД создаётся в рантайме, в репозитории ей не место
planner.db
planner.db-wal
planner.db-shm
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# --- Рантайм-данные приложения ---
# Создаётся при первом запуске, у каждого пользователя своё
.sync_times.json
custom_groups.json

# --- Кэш расписаний ---
# Папка schedules/ наполняется автоматически при загрузке групп.
# Если ты хочешь предзалить расписание в репозиторий — закомментируй
# эти две строки, но помни: кэш быстро устаревает и весит немало.
Ezh/schedules/*.json
!Ezh/schedules/.gitkeep

# --- Логи ---
*.log
logs/

# --- Секреты и окружение ---
.env
.env.*
!.env.example
secrets.json
*.pem
*.key

# --- СЕССИИ И ДАННЫЕ ЕЖ ПРО (MOODLE) ---
